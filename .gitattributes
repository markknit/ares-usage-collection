* text=auto

# Shell scripts are executed on Linux servers and must not acquire Windows CRLF endings.
*.sh text eol=lf
*.bash text eol=lf
offline-installer/rollout/** text=auto eol=lf
local-server/** text=auto eol=lf
offline-installer/package.conf text eol=lf

# Owner-supplied, already tested admin pages and manual are copied byte-for-byte.
offline-installer/admin-content/admin.html -text
offline-installer/admin-content/index.htmlf -text
offline-installer/admin-content/ARES_Sync_User_Guide.pdf -text

# Preserve the imported release, its checksums, PDF and handoff exactly.
offline-installer/internet-lockdown/** -text
